# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# 忽略根目录下全部文件和文件夹
/*

# 放行 Java_learn 文件夹（必须这一行，git才能进入子目录）
!/Java_learn

# 进入Java_learn后，先忽略里面所有内容
/Java_learn/*

# 放行需要版本管理的内容
!/Java_learn/src
!/Java_learn/pom.xml
